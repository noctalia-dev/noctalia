[Desktop Entry]
Categories=Graphics;ImageProcessing;
Comment=Edit images with Noctalia's built-in image annotator
Exec=noctalia msg annotate %f
Icon=noctalia
MimeType=image/bmp;image/gif;image/vnd.microsoft.icon;image/jpeg;image/jxl;image/png;image/qoi;image/svg+xml;image/x-tga;image/webp;image/vnd.wap.wbmp;image/x-portable-anymap;image/x-portable-graymap;image/x-portable-pixmap;
Name=Noctalia Image Annotator
NoDisplay=true
Terminal=false
Type=Application
Version=1.5
