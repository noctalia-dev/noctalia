# set NOCTALIA_COMP_DEBUG_FILE to debug
__noctalia_debug() {
    local file="$NOCTALIA_COMP_DEBUG_FILE"
    if [[ -n ${file} ]]; then
        echo "$*" >> "${file}"
    fi
}

_noctalia_get_panels() {
    local output available
    local -a panels

    # run `msg panel-toggle` with dummy panel option
    output=$(noctalia msg panel-toggle '[' 2>&1)
    available=${${output#*available: }%)}

    if [[ "$available" == "$output" ]]; then
        _message 'no panels found'
        return
    fi

    panels=(${(s:, :)available})

    if (( $#panels )); then
        _values 'panel' "${panels[@]}"
    else
        _message 'no panels found'
    fi
}

_noctalia_get_plugin_sources() {
    local -a sources

    plugin_list=$(noctalia msg plugins source list 2>/dev/null)
    # grab everything up to the first whitespace
    sources=(${${(f)plugin_list}%% *})

    if [[ ${#sources[@]} -gt 0 ]]; then
        _values 'plugin source' $sources
    else
        _message 'no plugin sources found'
    fi
}

_noctalia_get_enabled_plugins() {
    local -a plugins

    plugin_list=$(noctalia msg plugins list 2>/dev/null | grep 'enabled$')
    # grab everything up to the first whitespace
    plugins=(${${(f)plugin_list}%% *})

    if [[ ${#plugins[@]} -gt 0 ]]; then
        _values 'enabled plugin' $plugins
    else
        _message 'no enabled plugins found'
    fi
}

_noctalia_get_disabled_plugins() {
    local -a plugins

    plugin_list=$(noctalia msg plugins list 2>/dev/null | grep 'disabled$')
    # grab everything up to the first whitespace
    plugins=(${${(f)plugin_list}%% *})

    if [[ ${#plugins[@]} -gt 0 ]]; then
        _values 'disabled plugin' $plugins
    else
        _message 'no disabled plugins found'
    fi
}

# `noctalia <TAB>` completions
_noctalia() {
    local context state state_descr line
    typeset -A opt_args

    __noctalia_debug "\n===== _noctalia: CURRENT=${CURRENT} words=(${words[*]})"

    _arguments -C \
        '(-h --help)'{-h,--help}'[Show help message]' \
        '(-v --version)'{-v,--version}'[Show version information]' \
        '(-d --daemon)'{-d,--daemon}'[Run in background]' \
        '1: :->cmds' \
        '*:: :->args'

    __noctalia_debug "_noctalia: state=${state} line=(${line[*]})"

    case "$state" in
        cmds)
            __noctalia_debug "_noctalia: dispatching top-level command list"
            _describe -t commands 'noctalia command' _NOCTALIA_TOP_COMMANDS
            ;;
        args)
            __noctalia_debug "_noctalia: dispatching to subcommand '${line[1]}'"
            case $line[1] in
                completions)
                    _values 'shell' bash fish zsh
                    ;;
                config)
                    _noctalia_config
                    ;;
                msg)
                    _noctalia_msg
                    ;;
                plugins)
                    _noctalia_plugins
                    ;;
                theme)
                    _noctalia_theme
                    ;;
                *)
                    __noctalia_debug "_noctalia: no handler for '${line[1]}'"
                    ;;
            esac
            ;;
    esac
}

# `noctalia config <TAB>` completions
_noctalia_config() {
    local context state state_descr subline
    typeset -A opt_args

    _arguments -C \
        '--help[Show help message]' \
        '1: :->subcmds' \
        '*:: :->subargs'

    case "$state" in
        subcmds)
            __noctalia_debug "  _noctalia_config: completing subcommand name"
            _describe -t commands 'config command' _NOCTALIA_CONFIG_COMMANDS
            ;;
        subargs)
            __noctalia_debug "  _noctalia_config: completing args for '${line[1]}'"
            case ${line[1]} in
                export)
                    _values 'export type' merged full
                    ;;
                replay-report)
                    _arguments \
                        '--help[Show help message]' \
                        '--target[Target directory to reconstruct to]:dir:_files -/' \
                        '--flattened[Reconstruct a single config.toml]' \
                        '--force[Force reconstruction]' \
                        '1:report file:_files'
                    ;;
                validate)
                    _arguments \
                        '--help[Show help message]' \
                        '1:config path:_files -g "*.toml"'
                    ;;
            esac
            ;;
    esac
}

# `noctalia msg <TAB>` completions
_noctalia_msg() {
    __noctalia_debug "  _noctalia_msg: before shift CURRENT=${CURRENT} words=(${words[*]})"
    (( CURRENT -= 1 ))
    shift words
    __noctalia_debug "  _noctalia_msg: after shift  CURRENT=${CURRENT} words=(${words[*]})"

    if (( CURRENT == 1 )); then
        __noctalia_debug "  _noctalia_msg: completing msg subcommand name"
        _describe -t commands 'msg command' _NOCTALIA_MSG_COMMANDS
    else
        __noctalia_debug "  _noctalia_msg: completing args for '${words[1]}' (CURRENT=${CURRENT}, words=(${words[*]}))"

        case ${words[1]} in
            bar-auto-hide-set)
                _values 'state' "${_NOCTALIA_BOOL_STATES[@]}" smart
                ;;
            bar-layer-set)
                _values 'layer' top overlay
                ;;
            color-scheme-set)
                if (( CURRENT == 2 )); then
                    _values 'source' builtin wallpaper community custom
                elif (( CURRENT == 3 )) && [[ "${words[2]}" == "builtin" ]]; then
                    _values 'generator scheme' "${_NOCTALIA_BUILTIN_PALETTES[@]}"
                elif (( CURRENT == 3 )) && [[ "${words[2]}" == "wallpaper" ]]; then
                    _values 'generator scheme' "${_NOCTALIA_WALLPAPER_GENERATORS[@]}"
                elif (( CURRENT == 3 )); then
                    _message 'scheme name'
                fi
                ;;
            log-level-set)
                _values 'log level' debug info warn error
                ;;
            media)
                _values 'media action' next previous toggle play pause stop next-player previous-player
                ;;
            notification-dnd-set)
                _values 'state' "${_NOCTALIA_BOOL_STATES[@]}"
                ;;
            panel-open|panel-toggle|panel-close)
                _noctalia_get_panels
                ;;
            plugin)
                if (( CURRENT == 2 )); then
                    _noctalia_get_enabled_plugins
                elif (( CURRENT == 3 )); then
                    _values 'target' focused all
                else
                    _message 'event [payload]'
                fi
                ;;
            plugins)
                if (( CURRENT == 2 )); then
                    _values 'plugins command' list enable disable update source
                else
                    case ${words[2]} in
                        disable)
                            _noctalia_get_enabled_plugins
                            ;;
                        enable)
                            _noctalia_get_disabled_plugins
                            ;;
                        source)
                            if (( CURRENT == 3 )); then
                                _values 'source command' list add remove
                            elif (( CURRENT == 4 )) && [[ "${words[3]}" == "remove" ]]; then
                                _noctalia_get_plugin_sources
                            elif (( CURRENT == 5 )) && [[ "${words[3]}" == "add" ]]; then
                                _values 'source type' git path
                            fi
                            ;;
                        update)
                            _noctalia_get_plugin_sources
                            ;;
                    esac
                fi
                ;;
            power-cycle|taskbar-cycle|workspace-switch)
                _values 'direction' next prev
                ;;
            power-set)
                _values 'power profile' performance balanced power-saver
                ;;
            screenshot-fullscreen)
                _values 'target' pick monitor all
                ;;
            session)
                _values 'session action' lock suspend lock-and-suspend logout reboot shutdown
                ;;
            theme-mode-set)
                _values 'theme mode' dark light auto
                ;;
            wallpaper-set)
                _files
                ;;
        esac
    fi
}

# `noctalia plugins <TAB>` completions
_noctalia_plugins() {
    __noctalia_debug "  _noctalia_plugins: before shift CURRENT=${CURRENT} words=(${words[*]})"
    (( CURRENT -= 1 ))
    shift words
    __noctalia_debug "  _noctalia_plugins: after shift  CURRENT=${CURRENT} words=(${words[*]})"

    local -a commands
    commands=(
        'lint:Cross-check each plugin declared settings against its getConfig calls'
    )

    if (( CURRENT == 1 )); then
        __noctalia_debug "  _noctalia_plugins: completing subcommand name"
        _describe -t commands 'plugins command' commands
    else
        __noctalia_debug "  _noctalia_plugins: completing args for '${words[1]}'"
        case ${words[1]} in
            lint)
                _files -/
                ;;
        esac
    fi
}

# `noctalia themes <TAB>` completions
_noctalia_theme() {
    __noctalia_debug "  _noctalia_theme: CURRENT=${CURRENT} words=(${words[*]})"
    _arguments -C "${_NOCTALIA_THEME_OPTS[@]}"
}

_noctalia "$@"
